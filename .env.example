# Dragon hunt — marketplace / analytics API keys
# Copy to `.env.local` (never commit secrets). Without these keys, TR hunt
# uses verified marketplace catalog + best-effort Amazon TR public search
# for title/image/URL identity. Scores stay heuristic.

# --- Amazon Product Advertising API 5.0 (amazon.com.tr) ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
# Optional overrides:
# AMAZON_PAAPI_HOST=webservices.amazon.com.tr
# AMAZON_PAAPI_REGION=eu-west-1

# --- Keepa (Amazon history; does NOT cover amazon.com.tr as of 2026) ---
KEEPA_API_KEY=

# --- Trendyol Partner API (seller catalog — not public marketplace search) ---
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# --- Hepsiburada merchant integration ---
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_SERVICE_KEY=

# --- PTT AVM partner API (if / when issued) ---
PTTAVM_API_KEY=
